# =============================================================================
# .gitignore for SynZIF-8 release
# Tells git to skip these paths when committing.
# =============================================================================

# --- Python caches and bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Build / packaging artefacts ---
build/
develop-eggs/
dist/
eggs/
.eggs/
*.egg-info/
*.egg
wheels/
pip-wheel-metadata/
pip-log.txt
pip-delete-this-directory.txt

# --- Virtual environments ---
.env
.venv/
venv/
env/
ENV/

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Model checkpoints (too large for git; use HuggingFace / external storage) ---
*.pth
*.ckpt
*.pt
*.bin
*.safetensors
*.onnx
*.tflite

# --- Dataset binary files (use HuggingFace; see README.md) ---
*.npz
*.npy
*.h5
*.hdf5
*.tfrecord
*.lmdb/
*.tar
*.tar.gz
*.zip

# --- Training outputs / experiment logs ---
runs/
outputs/
output/
logs/
wandb/
tensorboard/
mlruns/
lightning_logs/

# --- Stylization / baseline external pretrained dirs (cloned via SETUP.md) ---
baselines/foundation_pose/megapose/external/
baselines/foundation_pose/gigapose/external/
baselines/foundation_pose/foundationpose/external/

# --- Stylization training side-products ---
data_generation/stylization/exp*/checkpoints/
data_generation/stylization/exp*/results/
data_generation/stylization/exp*/train_log.json
data_generation/stylization/exp*/*.log

# --- Local generated dataset (DATA_ROOT is external; never commit) ---
dataset_v6/
dataset_v6_sem/

# --- Real SEM reference images (collaborator-owned; not redistributed
#     per Croissant metadata on the Hugging Face dataset). Users must
#     provide their own at data_generation/stylization/SEM_dev_70/. See
#     Sec 3.1 + Appendix B of the paper and data_generation/README.md. ---
data_generation/stylization/SEM_dev_70/
**/SEM_dev_70/
**/sem_reference/
**/real_sem/

# --- Misc ---
*.log
*.tmp
.cache/
coverage.xml
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.mypy_cache/
